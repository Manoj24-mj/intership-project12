# ===================================================
# ArtLoop - Environment Variables Configuration
# ===================================================

# Database: MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/artloop?retryWrites=true&w=majority
# (If left empty, ArtLoop automatically uses its zero-config in-memory database)
MONGODB_URI=""

# Server Port
PORT=3000

# Node Environment: 'development' or 'production'
NODE_ENV="development"

# Session & JWT secret
SESSION_SECRET="artloop_unified_mentor_super_secret_key_2026"

# Deployed Frontend URL (for CORS and production cookies)
FRONTEND_URL="http://localhost:3000"

# Optional Secure Administrator Seed Configuration
ADMIN_NAME="ArtLoop Administrator"
ADMIN_EMAIL="admin@artloop.in"
ADMIN_PASSWORD="admin123"

# System URLs (Injected by host environment)
APP_URL="MY_APP_URL"

